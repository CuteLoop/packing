\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Feasible square side length $L$ over wall time for $N \in \{5, 10, 25, 50, 100, 200\}$ (panels a--f). Thin lines are individual worker traces; the thick line is the aggregate best-so-far envelope. The right panel for each row shows the best packing geometry found. At $N = 200$ only one worker reached feasibility, producing a single visible trace.}}{4}{figure.caption.3}\protected@file@percent }
\newlabel{fig:timeseries}{{1}{4}{Feasible square side length $L$ over wall time for $N \in \{5, 10, 25, 50, 100, 200\}$ (panels a--f). Thin lines are individual worker traces; the thick line is the aggregate best-so-far envelope. The right panel for each row shows the best packing geometry found. At $N = 200$ only one worker reached feasibility, producing a single visible trace}{figure.caption.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Best-so-far packing efficiency $\eta = N A_p / L^2$ versus wall time. Thin lines are individual workers; the thick line is the median across feasible workers. The plateau reflects the bisection loop locking in a bracket; improvement thereafter comes from the polish stage.}}{4}{figure.caption.4}\protected@file@percent }
\newlabel{fig:density}{{2}{4}{Best-so-far packing efficiency $\eta = N A_p / L^2$ versus wall time. Thin lines are individual workers; the thick line is the median across feasible workers. The plateau reflects the bisection loop locking in a bracket; improvement thereafter comes from the polish stage}{figure.caption.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Wall time to final best configuration by $N$. Boxes are interquartile ranges; dots are individual workers. The sharp increase at $N \geq 50$ confirms that the polish stage, not bisection, produces most improvement at scale.}}{4}{figure.caption.4}\protected@file@percent }
\newlabel{fig:timetobest}{{3}{4}{Wall time to final best configuration by $N$. Boxes are interquartile ranges; dots are individual workers. The sharp increase at $N \geq 50$ confirms that the polish stage, not bisection, produces most improvement at scale}{figure.caption.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Best packing efficiency $\eta $ versus $N$. The monotonic decline reflects both boundary geometry effects and a time budget that covers fewer trials per degree of freedom as $N$ grows.}}{4}{figure.caption.4}\protected@file@percent }
\newlabel{fig:densityN}{{4}{4}{Best packing efficiency $\eta $ versus $N$. The monotonic decline reflects both boundary geometry effects and a time budget that covers fewer trials per degree of freedom as $N$ grows}{figure.caption.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Packing efficiency $\eta $ versus $1/\!\sqrt  {N}$. The linear trend supports $\eta (N) \approx \eta _\infty + c/\!\sqrt  {N}$ with $\eta _\infty \approx 0.40$, grounded in the container perimeter-to-area scaling argument.}}{4}{figure.caption.4}\protected@file@percent }
\newlabel{fig:scaling}{{5}{4}{Packing efficiency $\eta $ versus $1/\!\sqrt {N}$. The linear trend supports $\eta (N) \approx \eta _\infty + c/\!\sqrt {N}$ with $\eta _\infty \approx 0.40$, grounded in the container perimeter-to-area scaling argument}{figure.caption.4}{}}
